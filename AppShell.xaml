<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="CityTrail.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CityTrail.Views"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Inicio"
                      Route="home"
                      ContentTemplate="{DataTemplate views:Home}" />
        <ShellContent Title="Explorar"
                      Route="explore"
                      ContentTemplate="{DataTemplate views:ExplorePage}" />
        <ShellContent Title="Favoritos"
                      Route="favorites"
                      ContentTemplate="{DataTemplate views:FavoritesPage}" />
    </TabBar>
</Shell>
